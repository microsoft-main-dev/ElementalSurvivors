--!strict
--[[
	Palette — все цвета игры в одном месте.

	Стиль плоский low-poly (раздел 2.1 ТЗ): силуэт и цвет — единственные средства
	различения объектов, поэтому палитра должна быть узкой и контрастной.
	Материалы только SmoothPlastic и Neon, текстур нет.

	Фирменные цвета взяты с логотипа 4pots games.
]]

local Palette = {
	-- Бренд
	Brand = table.freeze({
		dark = Color3.fromHex("#175C3D"),
		mid = Color3.fromHex("#4FA97C"),
		light = Color3.fromHex("#8FD3AC"),
		white = Color3.fromHex("#FFFFFF"),
	}),

	-- Стихии. Цвет врага кодирует его стихию (раздел 2.1 ТЗ).
	Element = table.freeze({
		Fire = Color3.fromHex("#E2603A"),
		Ice = Color3.fromHex("#5FC8E8"),
		Lightning = Color3.fromHex("#E8CE4B"),
		Nature = Color3.fromHex("#6FBF52"),
		Dark = Color3.fromHex("#7A5BC4"),
		Light = Color3.fromHex("#F2EFDF"),
	}),

	--[[
		Редкости питомцев (раздел 6 ТЗ). Цвет — единственный способ отличить
		редкость с одного взгляда: иконок у нас нет, а подпись читается медленнее.
		Шкала намеренно идёт от блёклого к яркому, а не «каждой редкости свой
		случайный цвет»: так порядок виден даже тому, кто впервые видит буквы.
	]]
	Rarity = table.freeze({
		B = Color3.fromHex("#8A9A92"),
		A = Color3.fromHex("#5FC8E8"),
		S = Color3.fromHex("#6FBF52"),
		SS = Color3.fromHex("#E8CE4B"),
		SSS = Color3.fromHex("#E2603A"),
	}),

	--[[
		Этапы звёздной лестницы (эволюция питомцев). Порядок тот же, что
		у Pets.StarStage: белые -> фиолетовые -> красные -> бриллиантовая.

		Звёзды рисуются цветом этапа везде, где показан питомец, поэтому
		цвет обязан лежать здесь, а не в панели: панелей с питомцами уже три.
	]]
	Stars = table.freeze({
		Color3.fromHex("#F2F7F4"),
		Color3.fromHex("#A98BE8"),
		Color3.fromHex("#E2603A"),
		Color3.fromHex("#8FE8F0"),
	}),

	--[[
		Снаряжение в инвентаре. Текстур у предметов нет и не будет до тех пор,
		пока владелец не даст ассеты, поэтому предмет — это цветной квадрат,
		и цвет обязан читаться как материал вещи: сталь шлема, кожа нагрудника,
		тёмная кожа сапог, золото амулета. Редкость поверх этого добавляет
		свечение (см. Client/UI/ItemIcon), а не свой цвет: иначе легендарные
		сапоги перестали бы быть сапогами.
	]]
	Gear = table.freeze({
		Helmet = Color3.fromHex("#9FB3C8"),
		Chest = Color3.fromHex("#A5734B"),
		Boots = Color3.fromHex("#6B4A32"),
		Trinket = Color3.fromHex("#E8CE4B"),
	}),

	--[[
		Враги, чей цвет не выводится из стихии (EnemyModel.palette).

		Слизни одной стихии, но трёх размеров, и в толпе игрок обязан с одного
		взгляда понимать, во что упёрся. Размер эту работу не делает: мелкий
		вблизи и крупный вдали на экране одинаковы, а цвет — нет.

		Шкала идёт от безобидного к опасному: бледно-голубой мелкий, зелёный
		крепкий, тёмно-синий гигант. Гигант не темнее пола арены намеренно —
		иначе самый опасный враг читался бы хуже всех.
	]]
	Enemy = table.freeze({
		bodies = table.freeze({
			SlimeSmall = Color3.fromHex("#9FD8EE"),
			SlimeStrong = Color3.fromHex("#6FBF52"),
			SlimeGiant = Color3.fromHex("#3A5BB8"),
			--[[
				Обноски гоблина. Стихию (Dark) цвет тела у них больше не
				кодирует — решение владельца, то же отступление от раздела 2.1,
				что и у слизней: фиолетовое тряпьё выглядело не тряпьём.

				Коричневый светлее пола дремучего леса намеренно: тёмная
				одежда на тёмном полу не оставляет силуэта вовсе.
			]]
			GoblinRags = Color3.fromHex("#7A5A3A"),
		}),
		--[[
			Враг под усилением босса: неуязвим и быстр. Цвет обязан кричать —
			игрок бьёт по нему и не видит урона, и без явной пометки это
			читается как поломка игры, а не как правило.

			Белый с холодным отливом не совпадает ни с одной стихией и ни
			с одним видом врага: усиленный слизень и усиленный гоблин
			обязаны быть одинаково «не трогай».
		]]
		buffed = Color3.fromHex("#DCE9FF"),
	}),

	--[[
		Именованные цвета мелких деталей — и у моделей боссов (Config/Models),
		и у врагов (EnemyModel.parts). Одна таблица на всех: сталь клинка
		у гоблина и сталь на посохе шамана — это один и тот же факт.

		Здесь всё, что не часть тела и стихии не подчиняется: кожа, одежда,
		металл, кость, дерево, перья. Стихия красит шкуру, а не штаны.
	]]
	Detail = table.freeze({
		eye = Color3.fromHex("#0E1214"),
		-- Камень портала и построек лобби. Тёмный вариант — рёбра и цоколь:
		-- один серый на всё превращает арку в силуэт без глубины.
		stone = Color3.fromHex("#6B6F63"),
		stoneDark = Color3.fromHex("#454A41"),
		-- Провал тени: капюшон статуи, щель бойницы. Не то же, что глаз
		-- врага, хотя цвет близок, — у них разные хозяева.
		shadow = Color3.fromHex("#10161A"),
		--[[
			Украшения яиц. Сам цвет яйца сюда не попадает: он живёт в
			Config/Eggs и оттуда же берётся 3D-моделью — блики и тени
			выводятся из него, а не записываются вторым числом.

			Здесь только то, что из цвета яйца не выводится: камень в оправе
			золотого и сияние сияющего.
		]]
		eggGem = Color3.fromHex("#3FD9C8"),
		eggAura = Color3.fromHex("#F2D97A"),
		-- Шкура гоблина. Не совпадает ни с одним слизнем и ни с базовым
		-- цветом шамана: это его подручные, а не он сам.
		skin = Color3.fromHex("#6E9147"),
		hood = Color3.fromHex("#B4462A"),
		cloth = Color3.fromHex("#2C3E6B"),
		leather = Color3.fromHex("#4A3120"),
		wood = Color3.fromHex("#6B4A2A"),
		--[[
			Крона дерева в два тона. Один тон превращает низкополигональное
			дерево в зелёный ком: гранями его делает не форма, а то, что
			соседние комья разного оттенка.
		]]
		leaf = Color3.fromHex("#4E8C3A"),
		--[[
			Торговец в лобби. Кожа бледная, а не зелёная как у гоблина: это
			не его родня, и путать их нельзя. Плащ бирюзовый — единственное
			холодное пятно в тёплой лавке, поэтому взгляд находит продавца
			раньше, чем прилавок.
		]]
		flesh = Color3.fromHex("#E8C9A8"),
		cloak = Color3.fromHex("#2F8C7E"),
		leafDark = Color3.fromHex("#37662A"),
		drum = Color3.fromHex("#8E2B24"),
		hide = Color3.fromHex("#C9B896"),
		steel = Color3.fromHex("#8A94A0"),
		bone = Color3.fromHex("#E6DCC0"),
		--[[
			Перья убора. Четыре цвета вразнобой — так он и читается как
			убор, а не как гребень: одинаковые перья сливаются в одну
			деталь, сколько бы их ни было.
		]]
		plumeWarm = Color3.fromHex("#E07B2A"),
		plumeCool = Color3.fromHex("#3A78C0"),
		plumeRed = Color3.fromHex("#C0392B"),
		plumeTeal = Color3.fromHex("#2FA8A0"),
	}),

	--[[
		Модели боссов из примитивов (Config/Models). Деталь называет роль
		цвета, а не цвет: primary, secondary и dark выводятся из базового
		цвета прямо в PartModel.TintsFor.

		accent от стихии не зависит вовсе: корона слизня, оправа посоха,
		обереги. Металл намеренно не совпадает ни с одной стихией, иначе
		на боссе Lightning корона слилась бы с телом.

		bases — базовый цвет модели, которой стихия не подходит. Ключ здесь
		и есть ключ модели: босса без записи красит его стихия. Гоблин-шаман
		стихии Dark, но фиолетовый гоблин — это не гоблин, а робот.
	]]
	Model = table.freeze({
		accent = Color3.fromHex("#D9A441"),
		--[[
			bases — базовый цвет модели, которой стихия не подходит.

			У питомцев это правило, а не исключение: они нарисованы зверями
			(assets/icons/pets), и медвежонок рыжий, а черепаха зелёная —
			независимо от того, какой стихией они бьют. Стихию у питомца
			по-прежнему видно, но не телом, а свечением редкости.
		]]
		bases = table.freeze({
			GoblinShaman = Color3.fromHex("#4E7A34"),
			EmberCub = Color3.fromHex("#D2662B"),
			FrostPup = Color3.fromHex("#5FB8E8"),
			MossSprout = Color3.fromHex("#4E9E3E"),
			SparkKit = Color3.fromHex("#E8C860"),
			DuskMoth = Color3.fromHex("#6B4A8C"),
			GlowFinch = Color3.fromHex("#F2E9D0"),
			MagmaHound = Color3.fromHex("#E2793A"),
			GlacierOwl = Color3.fromHex("#6FC4E0"),
			StormDrake = Color3.fromHex("#E8CE4B"),
			VoidLynx = Color3.fromHex("#2E2038"),
			SolarPhoenix = Color3.fromHex("#F2DCA0"),
			VerdantWarden = Color3.fromHex("#5E8C46"),
		}),
	}),

	--[[
		Древо талантов. Стихийные узлы красятся своей стихией, а всё, что их
		связывает, — медью: общие узлы, магистрали и мосты между секторами.

		Медь намеренно не совпадает ни с одной стихией. Первый вариант красил
		магистрали цветом Fire, и половина дерева читалась как огненная ветвь.
	]]
	Talents = table.freeze({
		path = Color3.fromHex("#C98A5B"),
		-- Диск под деревом и разделители секторов: без них полторы сотни
		-- кружков висят в пустоте и ярусы не читаются вовсе.
		disc = Color3.fromHex("#161C19"),
		sector = Color3.fromHex("#2A332D"),
	}),

	-- Лобби
	Lobby = table.freeze({
		--[[
			Планировка владельца: зелёная поляна и мощёная площадь посреди неё.

			Трава заметно светлее плиты: площадь должна читаться как площадь,
			а не как пятно другого оттенка того же газона. Кайма темнее самой
			плитки — без неё круг выглядит наклейкой на траве.
		]]
		grass = Color3.fromHex("#3E7A3C"),
		plaza = Color3.fromHex("#8E8C7E"),
		plazaRim = Color3.fromHex("#5F5E55"),
		floor = Color3.fromHex("#20302A"),
		floorAccent = Color3.fromHex("#27392F"),
		border = Color3.fromHex("#175C3D"),
		portal = Color3.fromHex("#4FA97C"),
		portalGlow = Color3.fromHex("#8FD3AC"),
		sign = Color3.fromHex("#1A241F"),
	}),

	--[[
		Арена. В M1 одна палитра; в M6 их станет 20 по числу локаций (раздел 5.1 ТЗ).

		Пол намеренно светлее тумана: туман виден только как контраст,
		а тёмный туман поверх тёмного пола не читается вообще.
	]]
	Arena = table.freeze({
		floor = Color3.fromHex("#2E4349"),
		floorAccent = Color3.fromHex("#3A5359"),
		decor = Color3.fromHex("#3E5A62"),
		decorAccent = Color3.fromHex("#54A08F"),
		fog = Color3.fromHex("#080E10"),
		exit = Color3.fromHex("#E2603A"),
	}),

	--[[
		Палитры локаций. Ключ берётся из LocationDef.palette, и локация
		без своей записи откатывается на Arena выше — новая локация
		не должна ронять бой из-за забытого цвета.

		Обе лесные, но по-разному: поляна светлее и теплее, дремучий лес
		темнее и холоднее, с плотным туманом. Разница должна читаться
		мгновенно, иначе смена локации не ощущается вовсе.
	]]
	Arenas = table.freeze({
		ForestGlade = table.freeze({
			floor = Color3.fromHex("#33502F"),
			floorAccent = Color3.fromHex("#3F6238"),
			decor = Color3.fromHex("#4A6B3C"),
			decorAccent = Color3.fromHex("#8FD3AC"),
			fog = Color3.fromHex("#0E1A10"),
			exit = Color3.fromHex("#E2603A"),
		}),
		DeepForest = table.freeze({
			floor = Color3.fromHex("#1E2E28"),
			floorAccent = Color3.fromHex("#26382F"),
			decor = Color3.fromHex("#2A3D33"),
			decorAccent = Color3.fromHex("#4FA97C"),
			fog = Color3.fromHex("#060B08"),
			exit = Color3.fromHex("#E2603A"),
		}),
	}),

	--[[
		Секторы колеса фортуны, от дешёвого приза к дорогому.

		Список отдельный, а не «цвет по редкости»: у призов колеса редкости нет,
		есть порядок. Каждый цвет обязан быть виден на тёмной панели — первый
		вариант красил дешёвые секторы цветом самой панели, и половина колеса
		просто не рисовалась.
	]]
	Wheel = table.freeze({
		Color3.fromHex("#2F6B4F"),
		Color3.fromHex("#3E8C6A"),
		Color3.fromHex("#4FA97C"),
		Color3.fromHex("#5FC8E8"),
		Color3.fromHex("#E8CE4B"),
		Color3.fromHex("#E2603A"),
	}),

	-- Интерфейс
	UI = table.freeze({
		background = Color3.fromHex("#122019"),
		panel = Color3.fromHex("#1B2C24"),
		-- Пустая ячейка инвентаря: темнее панели, но не чёрная — ряд пустых
		-- ячеек должен читаться как сетка, а не как дырка в окне.
		slot = Color3.fromHex("#0E1813"),
		text = Color3.fromHex("#F2F7F4"),
		subtext = Color3.fromHex("#8FD3AC"),
		accent = Color3.fromHex("#4FA97C"),
		danger = Color3.fromHex("#E2603A"),
		-- Предупреждение без урона: телеграф призыва (там появятся враги,
		-- но сам круг не бьёт). Красный там был бы обманом.
		warning = Color3.fromHex("#E8CE4B"),
	}),
}

return table.freeze(Palette)
