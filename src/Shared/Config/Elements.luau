--!strict
--[[
	Elements — список стихий проекта (раздел 6 ТЗ).

	Отдельным файлом, потому что перечислить стихии нужно в трёх местах сразу:
	дерево талантов раскладывает по ним ветви, экипировка усиливает все шесть
	разом, а интерфейс красит по ним что угодно. Тип Element в Types описывает,
	какие значения допустимы; здесь лежит то же самое в виде массива, по которому
	можно пройтись циклом.

	Порядок стабильный: от него зависит расположение ветвей дерева по кругу.
]]

local Types = require(script.Parent.Parent.Types)

local Elements = {}

Elements.List = table.freeze({
	"Fire",
	"Ice",
	"Lightning",
	"Nature",
	"Dark",
	"Light",
} :: { Types.Element })

return table.freeze(Elements)
