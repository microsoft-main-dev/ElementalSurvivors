--!strict
--[[
	Balance — все числа, которые балансятся правкой одной таблицы (правило 6 ТЗ).
	Логика их только читает и никогда не хардкодит своих значений.
]]

local Balance = {
	Lobby = table.freeze({
		floorSize = 200, -- сторона квадратного пола, стадов
		floorThickness = 4,
		borderHeight = 3, -- видимый бортик
		wallHeight = 40, -- невидимая стена, чтобы нельзя было упасть с платформы
		portalOffset = 40, -- насколько портал стоит от центра по -Z
		fogStart = 120,
		fogEnd = 400,
	}),

	Arena = table.freeze({
		-- Арена игрока со слотом i строится в точке (i * spacing, 0, 0) — раздел 2 ТЗ.
		spacing = 5000,
		maxSlots = 20,

		size = 400, -- сторона квадратной арены, стадов
		floorThickness = 4,
		wallHeight = 80, -- невидимые стены по периметру
		-- Колонны: настоящие препятствия с коллизией, враги их обходят.
		-- Их немного намеренно — плотная расстановка превратила бы арену в лабиринт,
		-- а бой должен идти на открытом пространстве.
		decorCount = 26,
		decorClearRadius = 48, -- свободный круг вокруг точки появления игрока
		exitOffset = 60, -- насколько площадка выхода стоит от центра по +Z

		-- Туман. Конец тумана обязан быть ближе радиуса спавна врагов,
		-- иначе видно, как они появляются из воздуха.
		fogStart = 50,
		fogEnd = 130,
	}),

	Combat = table.freeze({
		tickRate = 1 / 30, -- фиксированный шаг симуляции
		maxStepsPerFrame = 3, -- защита от спирали смерти при просадке сервера
		cellSize = 8, -- ячейка пространственного хеша

		-- Репликация (раздел 3.3 ТЗ)
		eventInterval = 0.1, -- пачка событий спавна/смерти раз в 100 мс
		resyncPerSecond = 90, -- сколько врагов в секунду досылать точными позициями
		resyncBlendTime = 0.25, -- за сколько секунд клиент доводит врага до истины

		-- Игрок
		playerMaxHealth = 100,
		playerWalkSpeed = 24,
		-- Радиус касания игрока. Должен соответствовать ширине персонажа (~2 стада),
		-- а не «на глазок с запасом»: вместе с радиусом врага он и есть хитбокс,
		-- и завышенное значение читается как удары по пустому месту.
		playerRadius = 1.7,
		invulnerability = 0.5, -- i-frames после получения урона, секунд
		deathReturnDelay = 3, -- через сколько секунд после смерти вернуть в лобби

		-- В каком радиусе способности ищут цели для наведения.
		abilitySearchRadius = 70,
		maxProjectiles = 160, -- потолок одновременно летящих снарядов на арену

		-- Враги
		separationRadius = 3.2, -- на каком расстоянии враги начинают расталкиваться
		separationStrength = 26,
		bobAmplitude = 0.35, -- покачивание вместо скелетной анимации
		bobSpeed = 6,
		spawnRadius = 140, -- радиус окружности спавна: чуть больше видимой области
		cullRadius = 320, -- дальше этого врага можно молча удалить при переполнении
		contactPadding = 0, -- добавка к сумме радиусов при проверке касания
	}),

	--[[
		Внутрибоевая прогрессия (раздел 3.6 ТЗ).
		Уровни забега не сохраняются — они сбрасываются каждый заход.
	]]
	Progression = table.freeze({
		maxActiveAbilities = 5, -- 1 стартовая + 4 подобранные
		starterAbility = "FireOrbit", -- в M4 её начнёт задавать питомец
		cardsPerLevel = 3,
		choiceTimeout = 25, -- если игрок не выбрал (отошёл), сервер выберет сам
		snapshotRate = 10, -- сколько раз в секунду обновляется HUD

		-- Кривая опыта: формула, а не таблица (правило 6 ТЗ).
		xpBase = 6,
		xpGrowth = 1.26,
	}),

	-- Кристаллы опыта и магнит.
	Pickup = table.freeze({
		magnetRadius = 16, -- в M5 станет характеристикой игрока
		magnetSpeed = 70,
		collectRadius = 3,
		maxAlive = 500,
		eventInterval = 0.1,
		size = 1.1,
		height = 1.2,
	}),

	Debug = table.freeze({
		showStats = true, -- оверлей FPS/врагов; выключить перед релизом (M7)
	}),
}

-- Сколько опыта нужно, чтобы уйти с уровня level на следующий.
function Balance.XpForLevel(level: number): number
	return math.floor(Balance.Progression.xpBase * Balance.Progression.xpGrowth ^ (level - 1) + 0.5)
end

return table.freeze(Balance)
