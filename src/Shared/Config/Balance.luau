-- Сколько опыта нужно, чтобы уйти с уровня level на следующий ВНУТРИ забега.
function Balance.XpForLevel(level: number): number
	return math.floor(Balance.Progression.xpBase * Balance.Progression.xpGrowth ^ (level - 1) + 0.5)
end

-- То же для мета-уровня персонажа, который живёт в профиле (M5).
-- Две разные кривые с похожими именами — поэтому обе подписаны.
function Balance.MetaXpForLevel(level: number): number
	return math.floor(Balance.Meta.xpBase * Balance.Meta.xpGrowth ^ (level - 1) + 0.5)
end

return table.freeze(Balance)
